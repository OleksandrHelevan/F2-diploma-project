{
  "realm": "bricklayers",
  "enabled": true,
  "registrationAllowed": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": false,
  "editUsernameAllowed": false,
  "loginTheme": "bricklayers",
  "roles": {
    "realm": [
      { "name": "SUPERADMIN", "description": "Full user CUD via API/UI" },
      { "name": "CUSTOMER", "description": "Bricklayers customer" },
      { "name": "FOREMAN", "description": "Site foreman" },
      { "name": "BUILDER", "description": "Builder worker" },
      { "name": "SUPPLIER", "description": "Supplier" }
    ]
  },
  "clients": [
    {
      "clientId": "bricklayers-load-test",
      "name": "bricklayers-load-test",
      "description": "Demo-only public client with password grant, used by k6 and lab scripts to obtain tokens",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "protocol": "openid-connect",
      "fullScopeAllowed": true,
      "attributes": { "access.token.lifespan": "1800" },
      "protocolMappers": [
        {
          "name": "user-service audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "user-service",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        },
        {
          "name": "chat-service audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "chat-service",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ],
      "defaultClientScopes": ["web-origins", "acr", "basic", "profile", "roles", "email"]
    },
    {
      "clientId": "user-service",
      "name": "user-service",
      "enabled": true,
      "publicClient": false,
      "bearerOnly": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "protocol": "openid-connect",
      "fullScopeAllowed": true,
      "protocolMappers": [
        {
          "name": "user-service audience",
