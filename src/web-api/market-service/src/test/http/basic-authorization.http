### 1. GET All products
GET http://localhost:8082/api/v1/products
Authorization: Basic oleksandr oleksandr
Accept: application/json

> {%
    client.test("GET all -> 200", () => client.assert(response.status === 200, "status " + response.status));
%}

### 2. CREATE One product
POST http://localhost:8082/api/v1/products
Authorization: Basic oleksandr oleksandr
Content-Type: application/json

{
  "supplierId": "49d81772-4eb3-466c-a257-0300c1e89de6",
  "name": "Цемент М500",
  "description": "Портландцемент М500, мішок 25 кг",
  "category": "Сипучі матеріали",
  "unit": "мішок",
  "price": 190.0,
  "amount": 1000,
  "available": true
}

> {%
    client.test("CREATE -> 201", () => {
        client.assert(response.status === 201, "status " + response.status);
        client.assert(response.body.createdBy === "oleksandr", "createdBy " + response.body.createdBy);
    });
    client.global.set("productId", response.body.id);
%}

### 3. GET One product
GET http://localhost:8082/api/v1/products/{{productId}}
Authorization: Basic oleksandr oleksandr
Accept: application/json

> {%
    client.test("GET one -> 200", () => client.assert(response.status === 200, "status " + response.status));
%}

### 4. UPDATE One product
PUT http://localhost:8082/api/v1/products/{{productId}}
Authorization: Basic oleksandr oleksandr
Content-Type: application/json

{
  "supplierId": "49d81772-4eb3-466c-a257-0300c1e89de6",
  "name": "Цемент М500 (оновлено)",
  "description": "Портландцемент М500, мішок 25 кг",
  "category": "Сипучі матеріали",
  "unit": "мішок",
  "price": 200.0,
  "amount": 700,
  "available": true
}

> {%
    client.test("UPDATE -> 200", () => {
        client.assert(response.status === 200, "status " + response.status);
        client.assert(response.body.lastModifiedBy === "oleksandr", "lastModifiedBy " + response.body.lastModifiedBy);
    });
%}

### 5. DELETE One product
DELETE http://localhost:8082/api/v1/products/{{productId}}
Authorization: Basic oleksandr oleksandr

> {%
    client.test("DELETE -> 204", () => client.assert(response.status === 204, "status " + response.status));
%}
