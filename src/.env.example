# Local Docker Compose settings. Copy these into your existing .env file.
AUTH_SERVICE_PORT=8084
POSTGRES_VERSION=16-alpine
POSTGRES_CONTAINER_NAME=bricklayers-users-db
USERS_DB_NAME=users_db
USERS_DB_USER=users_service
USERS_DB_PASSWORD=change-me
POSTGRES_PORT=5433
DB_HEALTHCHECK_INTERVAL=5s
DB_HEALTHCHECK_TIMEOUT=5s
DB_HEALTHCHECK_RETRIES=10

KEYCLOAK_VERSION=25.0
KEYCLOAK_CONTAINER_NAME=bricklayers-keycloak
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me
KEYCLOAK_HOST=localhost
KEYCLOAK_HOSTNAME_STRICT=false
KEYCLOAK_HTTP_ENABLED=true
KEYCLOAK_REALM=bricklayers
KEYCLOAK_REALM_FILE=./keycloak/bricklayers-realm.json
# This must match the service-account client secret in keycloak/bricklayers-realm.json.
KEYCLOAK_ADMIN_CLIENT_SECRET=user-sync-service-secret
KEYCLOAK_SYNC_ENABLED=true

PROJECT_SERVICE_CONTAINER_NAME=bricklayers-project-service
PROJECT_SERVICE_PORT=8082
PROJECT_SERVICE_INTERNAL_PORT=8082
SPRING_DATA_MONGODB_NAME=chat_db
# Required. Use the Atlas connection string from MongoDB Atlas -> Connect -> Drivers.
MONGO_URI=mongodb+srv://<db-user>:<password>@<cluster-host>/<database>?retryWrites=true&w=majority
CHAT_DEMO_ENABLED=false
KEYCLOAK_SWAGGER_PORT=8085
KEYCLOAK_SWAGGER_CONTAINER_NAME=bricklayers-keycloak-swagger

WEB_APP_CONTAINER_NAME=bricklayers-web-app
WEB_APP_PORT=3000
WEB_APP_INTERNAL_PORT=3000
USERS_DB_VOLUME=users_db_data

# --- Labs 2-4: replicas, load balancer, Redis ---
# user-service and chat-service publish no ports; everything goes through HAProxy on LB_PORT.
USER_SERVICE_REPLICAS=2
CHAT_SERVICE_REPLICAS=2
LB_PORT=8080
LB_STATS_PORT=8404
# roundrobin | leastconn | source (IP hash)
LB_ALGORITHM=roundrobin
# chat-service -> user-service calls also go through the load balancer.
USER_SERVICE_INTERNAL_URL=http://lb:8080
DB_POOL_SIZE=10
REDIS_VERSION=7.4-alpine
CACHE_ENABLED=true
CACHE_TTL_SECONDS=300
# lab3 enables the X-Lab-Slow-Instance delay filter used by the Lab 3 experiments.
SPRING_PROFILES_ACTIVE=default
SECURITY_LOG_LEVEL=INFO

# --- Lab 5: async processing (bounded @Async pools) ---
# user-service pool: account overview + hand-off of e-mails to notification-service
ASYNC_CORE_SIZE=4
ASYNC_MAX_SIZE=8
ASYNC_QUEUE_CAPACITY=50

# --- notification-service (Labs 5-6): outbox, SMTP via Mailpit, Quartz ---
NOTIFICATION_SERVICE_REPLICAS=2
NOTIFICATIONS_DB_NAME=notifications_db
NOTIFICATIONS_DB_USER=notifications_service
NOTIFICATIONS_DB_PASSWORD=notifications_password
NOTIFICATIONS_DB_PORT=5435
NOTIFICATIONS_DB_VOLUME=notifications_db_data
MAILPIT_UI_PORT=8025
# Emulated round trip of a commercial e-mail API; 0s sends immediately.
MAIL_PROVIDER_LATENCY=1s
NOTIFICATION_ASYNC_CORE_SIZE=4
NOTIFICATION_ASYNC_MAX_SIZE=8
NOTIFICATION_ASYNC_QUEUE_CAPACITY=50
# Lab 6: JDBC job store in notifications_db, clustered across notification-service replicas
QUARTZ_TIME_ZONE=Europe/Kyiv
NOTIFICATION_RETRY_INTERVAL=60s
NOTIFICATION_RETENTION_DAYS=30
